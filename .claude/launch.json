{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "djhuevo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let f=path.join('/Users/devinjones/Desktop/djhuevo',req.url==='/'?'/index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('Not found')}else{const ext=path.extname(f);const m={'html':'text/html','css':'text/css','js':'application/javascript','svg':'image/svg+xml','jpg':'image/jpeg','jpeg':'image/jpeg','png':'image/png','m4a':'audio/mp4','mp4':'video/mp4','ico':'image/x-icon','json':'application/json'};res.writeHead(200,{'Content-Type':m[ext.slice(1)]||'application/octet-stream'});res.end(d)}})}).listen(3456,()=>console.log('ready'))"],
      "port": 3456
    }
  ]
}
